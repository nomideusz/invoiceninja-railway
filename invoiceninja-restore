#!/bin/sh
# Restore a backup, e.g. `invoiceninja-restore Mon` (from the Railway bucket) or
# `invoiceninja-restore /tmp/invoiceninja-Mon.tar.gz`: replaces the database and
# the stored files with the backup's. Run it in railway ssh.
set -eu
src=${1:?usage: invoiceninja-restore Mon|Tue|Wed|Thu|Fri|Sat|Sun|/path/to/backup.tar.gz}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

case $src in
  /*) cp "$src" "$tmp/backup.tar.gz" ;;
  *) curl -fsS --aws-sigv4 "aws:amz:${S3_REGION:-auto}:s3" \
       -u "$S3_ACCESS_KEY_ID:$S3_SECRET_ACCESS_KEY" \
       -o "$tmp/backup.tar.gz" "https://$S3_BUCKET.${S3_ENDPOINT#https://}/invoiceninja-$src.tar.gz" ;;
esac
tar -xzf "$tmp/backup.tar.gz" -C "$tmp" database.sql app_key app

MYSQL_PWD="$DB_PASSWORD" mariadb -h "$DB_HOST" -P "${DB_PORT:-3306}" -u "$DB_USERNAME" "$DB_DATABASE" < "$tmp/database.sql"
rm -rf /var/www/html/storage/app.old
mv /var/www/html/storage/app /var/www/html/storage/app.old
mv "$tmp/app" /var/www/html/storage/app
chown -R www-data:www-data /var/www/html/storage/app
rm -rf /var/www/html/storage/app.old
cd /var/www/html
runuser -u www-data -- php artisan migrate --force  # a backup from an older version
runuser -u www-data -- php artisan cache:clear
echo "invoiceninja-restore: restored $src"

# Payment gateway, email and bank credentials are stored encrypted with APP_KEY.
if [ "$(cat "$tmp/app_key")" != "$APP_KEY" ]; then
  echo "invoiceninja-restore: this backup was made with a different APP_KEY. Set the service's"
  echo "APP_KEY variable to the line below and redeploy, or its stored credentials can't be read:"
  cat "$tmp/app_key"
fi
